---
// Each card is a real Solution-Focused Therapy technique with its own
// Journal post behind it (src/content/journal/<slug>.md) — not a
// placeholder grid, so these link straight through to a full walkthrough.
const cards = [
	{
		slug: 'the-miracle-question',
		title: 'The Miracle Question',
		body: 'A simple question that helps shift focus from the problem to what things actually look like once it eases.',
	},
	{
		slug: 'scaling-progress',
		title: 'Scaling Progress',
		body: 'Turning a vague sense of "better or worse" into a number you can actually track session to session.',
	},
	{
		slug: 'exception-finding',
		title: 'Exception-Finding',
		body: 'Looking for the times the problem is already a little less present, and asking what was different about them.',
	},
	{
		slug: 'small-steps',
		title: 'Small Steps',
		body: 'Why the most useful next step is usually smaller than it feels like it should be.',
	},
];
---

<section class="clear-structure">
	<div class="wrap">
		<span class="eyebrow">Solution-focused therapy</span>
		<h2>Looking for clear structure?</h2>
		<p class="structure-subtext">Common pathways counselling can go.</p>
		<div class="structure-grid">
			{
				cards.map((card) => (
					<a class="structure-card" href={`/journal/${card.slug}/`}>
						<h3>{card.title}</h3>
						<p>{card.body}</p>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.clear-structure {
		padding: var(--space-20) 0;
		background: var(--color-bg-card);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.clear-structure .eyebrow {
		margin-bottom: var(--space-4);
		display: block;
	}

	.clear-structure h2 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-4);
	}

	.structure-subtext {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-10);
	}

	.structure-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-8);
	}

	.structure-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.structure-card h3 {
		font-size: var(--fs-card-title);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		margin: 0 0 var(--space-2);
		transition: color 0.15s ease;
	}

	.structure-card:hover h3 {
		color: var(--color-accent);
	}

	.structure-card p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media (max-width: 820px) {
		.structure-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-8) var(--space-6);
		}
	}

	@media (max-width: 480px) {
		.structure-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
