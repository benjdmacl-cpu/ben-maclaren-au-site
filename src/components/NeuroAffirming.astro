---
import { Image } from 'astro:assets';
import infinityIcon from '../assets/neuro-affirming/infinity-icon.png';
---

<section class="neuro-affirming">
	<div class="wrap">
		<div class="neuro-row">
			<div class="neuro-text">
				<h2>A neuro-affirming practice</h2>
				<p class="neuro-body">
					You are not broken. You are not a problem to be solved.
				</p>
				<p class="neuro-body">
					Neurodiversity is a beautiful part of our species. It gives us a richness of thought and ways
					of experiencing the world.
				</p>
				<p class="neuro-body">
					When our neurodiversity clashes with people, systems and places that are designed for
					different people, we become disadvantage and disabled. This is compounded by trauma and
					effects from stigma, marginalisation, bullying and exclusion. No diagnosis needed.
				</p>

				<a class="neuro-link" href="/neuro-affirming"
					>Read my neuroaffirming approach <span aria-hidden="true">→</span></a
				>
			</div>
			<Image class="neuro-icon" src={infinityIcon} alt="Neurodiversity infinity symbol" width={3840} height={1918} />
		</div>
	</div>
</section>

<style>
	.neuro-affirming {
		padding: var(--space-20) 0;
		background: var(--color-bg-card);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.neuro-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-8);
	}

	.neuro-text h2 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		font-weight: var(--fw-medium);
		margin: 0 0 var(--space-4);
	}

	.neuro-row :global(.neuro-icon) {
		flex: 0 0 auto;
		width: var(--space-30);
		height: auto;
	}

	@media (max-width: 820px) {
		.neuro-row {
			flex-direction: column;
			align-items: flex-start;
		}

		.neuro-row :global(.neuro-icon) {
			width: var(--space-20);
		}
	}

	.neuro-body {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-4);
	}

	.neuro-body:last-of-type {
		margin-bottom: 0;
	}

	.neuro-link {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		border-bottom: var(--border-hairline) solid var(--color-border);
		padding-bottom: var(--space-0-5);
		margin-top: var(--space-5);
	}

	.neuro-link:hover {
		color: var(--color-accent);
		border-color: var(--color-accent-link);
	}
</style>
