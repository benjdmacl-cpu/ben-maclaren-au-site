---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/ben-maclaren.jpg';
// Brand logos + official hex colours from simple-icons — Tabler (used
// elsewhere on the site) has no Substack mark, so these three come from a
// dedicated brand-icon set instead for accuracy and consistency across all
// three pills.
import substackIcon from 'simple-icons/icons/substack.svg?raw';
import facebookIcon from 'simple-icons/icons/facebook.svg?raw';
import youtubeIcon from 'simple-icons/icons/youtube.svg?raw';
// LinkedIn isn't in simple-icons (removed at some point, likely a takedown
// request) — sourced from Wikimedia Commons instead, with the background
// badge square stripped out so just the glyph remains, recoloured via
// currentColor to match the other three pills' transparent treatment.
import linkedinIcon from '../assets/icons/linkedin.svg?raw';

const socials = [
	{ name: 'substack', label: 'Read on Substack', href: '#', icon: substackIcon, brand: '#FF6719' },
	{ name: 'facebook', label: 'Find me on F', href: '#', icon: facebookIcon, brand: '#0866FF' },
	{ name: 'youtube', label: 'Watch on YouTube', href: '#', icon: youtubeIcon, brand: '#FF0000' },
	{ name: 'linkedin', label: 'Connect on LinkedIn', href: '#', icon: linkedinIcon, brand: '#0A66C2' },
];

// Visible — hrefs above are still '#' placeholders pending real URLs.
const SHOW_SOCIALS = true;
---

<section class="meet" id="meet">
	<div class="wrap">
		<div class="meet-portrait">
			<svg class="meet-motif" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<circle cx="100" cy="100" r="70" fill="none" stroke-width="1" opacity="0.4"></circle>
				<circle cx="100" cy="100" r="84" fill="none" stroke-width="0.9" opacity="0.28"></circle>
				<circle cx="100" cy="100" r="98" fill="none" stroke-width="0.8" opacity="0.18"></circle>
			</svg>
			<div class="frame">
				<Image src={portrait} alt="Ben Maclaren, counsellor in Canberra, ACT" width={420} height={420} />
			</div>
			<p class="meet-caption">Ben Maclaren · Canberra, ACT</p>
		</div>
		<div class="meet-text">
			<!-- Eyebrow hidden for now — reactivate later by uncommenting. -->
			<!-- <span class="eyebrow">Meet Ben</span> -->
			<h2>Welcome</h2>
			<p class="meet-intro">I'm Ben, a counsellor based here in Canberra, ACT.</p>
			<p class="meet-body">
				If you've made it this far, you've likely already done the hardest part: deciding to look for
				someone. I try and create a space to pause away from the pressures of daily life, where there's no
				judgement, just an honest conversation, at your pace, with someone glad you're here.
			</p>
			<p class="meet-signoff">Just a steady place to start, whenever you're ready.</p>
			{
				SHOW_SOCIALS && (
					<div class="meet-socials">
						{socials.map((social) => (
							<a
								class="social-pill"
								style={`--brand: ${social.brand}`}
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="social-icon" set:html={social.icon} />
								{social.label}
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.meet {
		padding: var(--space-27-5) 0;
		border-bottom: var(--border-hairline) solid var(--color-border);
		background: var(--color-bg-card);
	}

	.meet .wrap {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: var(--space-14);
		align-items: center;
	}

	.meet-portrait {
		max-width: 260px;
		position: relative;
	}

	.meet-motif {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 150%;
		height: 150%;
		transform: translate(-50%, -50%);
		z-index: 0;
		pointer-events: none;
		color: var(--terracotta);
	}

	.meet-motif circle {
		stroke: currentColor;
	}

	.frame {
		position: relative;
		z-index: 1;
		aspect-ratio: 1 / 1;
		border-radius: 50%;
		overflow: hidden;
		border: var(--border-hairline) solid var(--color-border);
		box-shadow: 0 1px 2px rgba(56, 44, 36, 0.06);
	}

	.frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(8%) saturate(92%);
		display: block;
	}

	.meet-caption {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-tight-label);
		color: var(--color-text-muted);
		text-align: left;
		margin: var(--space-4) 0 0;
	}

	.meet-text .eyebrow {
		margin-bottom: var(--space-5-5);
		display: block;
	}

	.meet-text h2 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		max-width: 480px;
		margin-bottom: var(--space-5);
	}

	.meet-intro {
		font-size: var(--fs-prose-body);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		max-width: 520px;
		margin: 0 0 var(--space-4);
	}

	.meet-body {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		max-width: 520px;
		margin: 0;
	}

	.meet-signoff {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-brand);
		color: var(--color-text-primary);
		margin: var(--space-7) 0 0;
	}

	.meet-socials {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.social-pill {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--brand);
		background: transparent;
		border: var(--border-hairline) solid var(--brand);
		padding: calc(var(--space-2-5) - var(--border-hairline)) calc(var(--space-4-5) - var(--border-hairline));
		border-radius: 999px;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.social-pill:hover {
		background: var(--brand);
		color: var(--color-bg-page);
	}

	.social-icon {
		display: inline-flex;
		width: 14px;
		height: 14px;
	}

	.social-icon :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	@media (max-width: 820px) {
		.meet .wrap {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}

		.meet-portrait {
			max-width: 180px;
		}

		.meet-text h2 {
			max-width: none;
		}
	}
</style>
