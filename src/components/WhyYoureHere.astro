---
const workOnCards = [
	{
		title: 'Get unstuck',
		body: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
	},
	{
		title: "Understand (and communicate) what you're feeling",
		body: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
	},
	{
		title: "Work out where you're going",
		body: 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.',
	},
	{
		title: 'Have better relationships, and better sex',
		body: 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
	},
];
---

<section class="why-youre-here">
	<div class="wrap">
		<h2>You might be here to</h2>
		<p class="why-youre-here-intro">
			Maybe life feels heavy at the moment. Maybe you're stuck, and you know something needs to change
			but can't see what.
		</p>
		<div class="why-work-on">
			<div class="why-work-on-grid">
				{
					workOnCards.map((card) => (
						<div class="why-work-on-card">
							<p class="why-work-on-card-title">{card.title}</p>
							<p class="why-work-on-card-body">{card.body}</p>
						</div>
					))
				}
			</div>
		</div>

		<p class="why-youre-here-specialties">
			I also work with: Anxiety · Depression · Drug &amp; alcohol recovery · ADHD · Autism
		</p>

		<p class="why-youre-here-closing">
			And if you think differently? Everything above still applies. We'll just do it in a way that
			fits how your brain works.
		</p>
	</div>
</section>

<style>
	.why-youre-here {
		padding: var(--space-20) 0;
		background: var(--color-bg-card);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.why-youre-here h2 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-5);
	}

	.why-youre-here-intro {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		max-width: 640px;
		margin: 0 0 var(--space-10);
	}

	.why-work-on {
		margin-top: var(--space-2);
	}

	.why-work-on-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-5);
	}

	.why-work-on-card {
		padding: var(--space-6);
		background: var(--color-bg-page);
		border: var(--border-hairline) solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.why-work-on-card-title {
		font-size: var(--fs-prose-body);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		margin: 0 0 var(--space-2);
	}

	.why-work-on-card-body {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media (max-width: 600px) {
		.why-work-on-grid {
			grid-template-columns: 1fr;
		}
	}

	.why-youre-here-specialties {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-tight-label);
		color: var(--color-text-secondary);
		margin: var(--space-10) 0 0;
	}

	.why-youre-here-closing {
		font-size: var(--fs-prose-body);
		font-style: italic;
		color: var(--color-text-secondary);
		max-width: 640px;
		margin: var(--space-10) 0 0;
	}
</style>
