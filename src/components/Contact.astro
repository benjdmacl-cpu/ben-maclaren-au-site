---
// Real booking link, already used by the Nav/Hero CTAs — reused here
// rather than a separate placeholder constant.
const BOOKING_URL = 'https://www.halaxy.com/book/benjamin-maclaren/counsellor/1780895/1362507';
---

<section class="contact" id="contact">
	<div class="wrap">
		<span class="eyebrow">Get in touch</span>
		<h2>Ready to take the first step?</h2>
		<div class="contact-grid">
			<div class="contact-booking">
				<span class="col-subheading">Book an intro call</span>
				<p class="lead">
					A 15-minute call, not a session. It's a chance to get a feel for how I work, ask any
					questions, and see if this is the right fit.
				</p>
				<p class="lead">
					We'll talk about what's bringing you here, and you can get a sense of my approach before
					deciding anything.
				</p>
				<a
					class="btn-outline"
					href={BOOKING_URL}
					target="_blank"
					rel="noopener noreferrer"
					data-goatcounter-click="contact-book">Book an intro call</a
				>
				<p class="contact-tertiary" id="contact-tertiary"></p>
				<p class="faq-pointer">Got a question first? <a href="#faq">Check the FAQ</a>.</p>
			</div>

			<div class="contact-form-col">
				<span class="col-subheading">Send a message</span>
				<p class="form-intro">
					If you'd rather write first, send a message instead. Tell me a little about what's going on,
					and I'll get back to you personally.
				</p>

				<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form">
					<input type="hidden" name="form-name" value="contact" />
					<p hidden>
						<label>Don't fill this out if you're human: <input name="bot-field" /></label>
					</p>

					<label class="field">
						<span>Name</span>
						<input type="text" name="name" autocomplete="name" required />
					</label>

					<label class="field">
						<span>Phone (optional)</span>
						<input type="tel" name="phone" autocomplete="tel" />
					</label>

					<label class="field">
						<span>Email</span>
						<input type="email" name="email" autocomplete="email" required />
					</label>

					<label class="field">
						<span>Message</span>
						<textarea name="message" rows="4" required></textarea>
					</label>

					<div class="captcha-row">
						<label class="captcha-field">
							<span id="captcha-question">— + — =</span>
							<input
								type="text"
								inputmode="numeric"
								name="captcha"
								id="captcha-input"
								autocomplete="off"
								required
							/>
						</label>
						<button type="submit">Send</button>
					</div>
				</form>

				<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		padding: var(--space-22-5) 0;
		background: var(--color-bg-page);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.contact .eyebrow {
		margin-bottom: var(--space-3-5);
		display: block;
	}

	.contact h2 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		max-width: 640px;
		margin-bottom: var(--space-13);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem; /* brief-specified exact value — no existing space token matches 64px */
	}

	.col-subheading {
		display: block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-wide-label);
		text-transform: uppercase;
		color: var(--color-accent);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-4);
	}

	.contact-booking .lead {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-4);
	}

	.btn-outline {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-accent-solid);
		background: transparent;
		border: var(--border-hairline) solid var(--color-accent-solid);
		padding: calc(var(--space-4) - var(--border-hairline)) calc(var(--space-7-5) - var(--border-hairline));
		border-radius: var(--radius-sm);
		transition:
			background 0.15s ease,
			color 0.15s ease;
		margin: var(--space-2) 0 var(--space-5);
	}

	.btn-outline:hover {
		background: var(--color-accent-solid);
		color: var(--color-on-accent);
	}

	.contact-tertiary {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-3);
	}

	.contact-tertiary :global(a) {
		color: var(--color-accent-link);
		text-decoration: underline;
	}

	.contact-tertiary :global(a:hover) {
		color: var(--color-accent);
	}

	.faq-pointer {
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		margin: 0;
	}

	.faq-pointer a {
		color: var(--color-accent-link);
		text-decoration: underline;
	}

	.faq-pointer a:hover {
		color: var(--color-accent);
	}

	.form-intro {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5);
	}

	#contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-1-5);
	}

	.field span {
		font-family: var(--font-mono);
		font-size: var(--fs-eyebrow);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.field input,
	.field textarea {
		font-family: var(--font-body);
		font-size: var(--fs-prose-body);
		color: var(--color-text-primary);
		background: var(--color-bg-page);
		border: var(--border-hairline) solid var(--color-accent-link);
		border-radius: var(--radius-sm);
		padding: var(--space-3) var(--space-4);
	}

	.field textarea {
		resize: vertical;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.captcha-row {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.captcha-field {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-secondary);
	}

	.captcha-field input {
		width: 60px;
		font-family: var(--font-body);
		font-size: var(--fs-prose-body);
		color: var(--color-text-primary);
		background: var(--color-bg-page);
		border: var(--border-hairline) solid var(--color-accent-link);
		border-radius: var(--radius-sm);
		padding: var(--space-2) var(--space-3);
		text-align: center;
	}

	.captcha-field input:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.captcha-row button {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		color: var(--color-on-accent);
		background: var(--color-accent-solid);
		border: none;
		padding: var(--space-3) var(--space-6);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.captcha-row button:hover {
		background: var(--color-accent);
	}

	.form-status {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		margin: var(--space-4) 0 0;
		min-height: 1.2em;
	}

	.form-status[data-state='success'] {
		color: var(--color-success);
	}

	.form-status[data-state='error'] {
		color: var(--color-accent);
	}

	@media (max-width: 820px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: var(--space-12); /* brief-specified 3rem, which is exactly --space-12 */
		}
	}
</style>

<script>
	// Number assembled from non-contiguous parts and inserted into the DOM
	// only after page load — never sitting as plain text/href in the page
	// source — so scraping bots reading raw HTML don't pick it up, while a
	// human visitor sees and can tap it normally. Same approach as Hero's
	// tertiary text/call line.
	const tertiaryEl = document.getElementById('contact-tertiary');
	if (tertiaryEl) {
		const parts = ['0494', '746', '502'];
		const number = parts.join('');
		const display = parts.join(' ');
		const message =
			"Hi Ben, I found your site and I'm thinking about counselling. Would love to have a chat when you're free.";
		tertiaryEl.innerHTML = `Or <a href="sms:${number}?body=${encodeURIComponent(message)}" data-goatcounter-click="contact-text">text</a> or <a href="tel:${number}" data-goatcounter-click="contact-call">call</a>: ${display}`;
	}

	const form = document.getElementById('contact-form');
	const questionEl = document.getElementById('captcha-question');
	const captchaInput = document.getElementById('captcha-input');
	const statusEl = document.getElementById('form-status');

	let expected = 0;

	function newCaptcha() {
		const a = Math.floor(Math.random() * 8) + 1;
		const b = Math.floor(Math.random() * 8) + 1;
		expected = a + b;
		if (questionEl) questionEl.textContent = `${a} + ${b} =`;
		if (captchaInput instanceof HTMLInputElement) captchaInput.value = '';
	}

	newCaptcha();

	if (form instanceof HTMLFormElement && statusEl && captchaInput instanceof HTMLInputElement) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			if (Number(captchaInput.value) !== expected) {
				statusEl.textContent = "That answer doesn't look right — please try again.";
				statusEl.dataset.state = 'error';
				newCaptcha();
				return;
			}

			const formData = new FormData(form);
			const body = new URLSearchParams();
			for (const [key, value] of formData.entries()) {
				if (key === 'captcha') continue;
				body.append(key, String(value));
			}

			try {
				const response = await fetch('/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: body.toString(),
				});

				if (!response.ok) throw new Error(`Status ${response.status}`);

				statusEl.textContent = "Thanks, message sent. I'll get back to you soon.";
				statusEl.dataset.state = 'success';
				form.reset();
				newCaptcha();
			} catch {
				statusEl.textContent = 'Something went wrong sending that — please try again, or email directly.';
				statusEl.dataset.state = 'error';
				newCaptcha();
			}
		});
	}
</script>
