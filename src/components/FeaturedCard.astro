---
// The pinned "start here" post — replaces the old lead/Tier 1 slot that
// used to be filled automatically by the newest response-type post. Now
// manual, via `featured: true` in frontmatter (see content.config.ts).
// Deliberately larger and more editorial than JournalCard, reusing the old
// lead treatment's drop-cap flourish so it still reads as "the important
// one" even though the ranking logic behind it is gone.
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_LABELS } from '../lib/journal-labels';

interface Props {
	href: string;
	title: string;
	excerpt: string;
	date: Date;
	category?: string;
}

const { href, title, excerpt, date, category } = Astro.props;
---

<article class="featured-card">
	<span class="featured-label">Start here</span>
	<span class="featured-kicker">
		{category && CATEGORY_LABELS[category]}
		{category && ' · '}
		<FormattedDate date={date} />
	</span>
	<h2 class="featured-title">
		<a href={href}>{title}</a>
	</h2>
	<p class="featured-excerpt">{excerpt}</p>
</article>

<style>
	.featured-card {
		background: var(--color-bg-card);
		border-radius: var(--radius-card);
		padding: var(--space-11);
		margin-bottom: var(--space-12);
	}

	.featured-label {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-micro);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-on-accent);
		background: var(--color-accent-solid);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		margin-bottom: var(--space-4);
	}

	.featured-kicker {
		font-family: var(--font-mono);
		font-size: var(--fs-eyebrow);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
		display: block;
		margin-bottom: var(--space-3);
	}

	.featured-title {
		font-size: var(--fs-lead-headline);
		line-height: var(--lh-tight);
		margin-bottom: var(--space-5);
	}

	.featured-title a {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.featured-title a:hover {
		color: var(--color-accent);
	}

	.featured-excerpt {
		font-size: var(--fs-h3);
		line-height: var(--lh-excerpt);
		color: var(--color-text-body);
		margin: 0;
		max-width: 640px;
	}

	.featured-excerpt::first-letter {
		font-family: var(--font-display);
		font-size: var(--fs-drop-cap);
		color: var(--color-text-primary);
		float: left;
		line-height: 0.8;
		padding-right: var(--space-2);
		padding-top: var(--space-1);
	}

	@media (max-width: 720px) {
		.featured-card {
			padding: var(--space-6);
		}
	}
</style>
