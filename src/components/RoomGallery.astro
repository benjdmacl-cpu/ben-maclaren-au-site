---
// No real room photos exist yet — three dashed placeholders stand in until
// real photos are available. Once real photos exist, replace the
// .gallery-item divs below with real <Image> components, e.g.:
//   import { Image } from 'astro:assets';
//   import gallery1 from '../assets/room/gallery-1.jpg';
//   <Image src={gallery1} alt="..." width={480} height={360} />
const placeholders = ['Session room, wide view', 'Seating close-up', 'Window / natural light'];
---

<section class="room-gallery">
	<div class="wrap">
		<div class="gallery-grid">
			{
				placeholders.map((label, i) => (
					<div
						class={`gallery-item ${i === 0 ? 'gallery-item--large' : ''}`}
						role="img"
						aria-label={`Counselling room photo placeholder — ${label}`}
					>
						<p class="gallery-item-label">
							{label}
							<br />
							<span>placeholder</span>
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.room-gallery {
		padding: var(--space-16) 0;
		background: var(--color-bg-card);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: var(--space-6);
	}

	.gallery-item {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		aspect-ratio: 4 / 3;
		background: var(--color-bg-page);
		border: var(--border-hairline) dashed var(--color-border);
		border-radius: var(--radius-card);
	}

	.gallery-item--large {
		grid-row: 1 / 3;
		aspect-ratio: auto;
	}

	.gallery-item-label {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		margin: 0;
		padding: var(--space-6);
	}

	.gallery-item-label span {
		font-size: var(--fs-micro);
	}

	@media (max-width: 600px) {
		.gallery-grid {
			grid-template-columns: 1fr;
			grid-template-rows: none;
		}

		.gallery-item--large {
			grid-row: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>
