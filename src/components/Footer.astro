<script>
	// Same base64 + atob() and split-parts anti-scraping approach used in
	// Hero/Contact/Faq — see those files for the rationale. Neither the
	// email address nor the phone number ever sits as plain text in the
	// page source; both are assembled client-side after load.
	const emailLink = document.getElementById('footer-email-link');
	if (emailLink instanceof HTMLAnchorElement) {
		const address = atob('aGVsbG9AYmVubWFjbGFyZW4uY29tLmF1');
		emailLink.href = `mailto:${address}`;

		emailLink.addEventListener('click', (e) => {
			e.preventDefault();
			navigator.clipboard?.writeText(address);
			const original = emailLink.textContent;
			emailLink.textContent = 'Copied!';
			setTimeout(() => {
				emailLink.textContent = original;
			}, 1500);
		});
	}

	const phoneEl = document.getElementById('footer-phone');
	if (phoneEl) {
		const parts = ['0494', '746', '502'];
		const number = parts.join('');
		const display = parts.join(' ');
		phoneEl.innerHTML = `<a href="tel:${number}" data-goatcounter-click="footer-call">${display}</a>`;
	}
</script>
