---
import { Image } from 'astro:assets';
import fishingPhoto from '../assets/hero/fishing-wide.jpg';
---

<section class="hero">
	<div class="hero-bg">
		<Image src={fishingPhoto} alt="" width={1536} height={2048} />
	</div>
	<div class="wrap hero-inner">
		<div class="status-row">
			<span class="status-pill"><span class="status-dot" aria-hidden="true"></span>Open for new clients</span>
			<span class="status-note">Evenings &amp; weekends available</span>
		</div>
		<h1>A way through difficult times</h1>
		<p class="tagline">I help find what works so you can get on living a good life.</p>
		<div class="hero-ctas">
			<a
				class="btn-primary"
				href="https://www.halaxy.com/book/benjamin-maclaren/counsellor/1780895/1362507"
				target="_blank"
				rel="noopener noreferrer"
				data-goatcounter-click="hero-book-intro-call">Book an intro call</a
			>
			<a class="btn-secondary" href="/#contact" data-goatcounter-click="hero-send-message">Send a message</a>
		</div>
		<p class="contact-tertiary" id="hero-tertiary"></p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 880px;
		/* Nav overlays this section (position: absolute), so its ~96px height
		   is reserved here as plain top padding — excluded from the
		   justify-content: center math below, so the text centers in the
		   space actually below the nav, not the full section height. */
		padding: 96px 0 var(--space-20);
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-bg :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 100%;
		display: block;
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 640px;
	}

	.hero-inner::before {
		content: '';
		position: absolute;
		inset: -64px -80px;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(
			ellipse at center,
			rgba(20, 16, 12, 0.55) 0%,
			rgba(20, 16, 12, 0.32) 45%,
			rgba(20, 16, 12, 0) 75%
		);
	}

	.status-row {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-6);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		color: var(--color-text-primary);
		background: var(--color-bg-card);
		border: var(--border-hairline) solid var(--color-border);
		padding: var(--space-2) var(--space-4);
		border-radius: 999px;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-success);
		flex-shrink: 0;
	}

	.status-note {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-on-dark);
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
	}

	.hero h1 {
		font-size: var(--fs-hero);
		line-height: var(--lh-hero);
		letter-spacing: var(--ls-hero-tight);
		color: var(--color-text-on-dark);
		text-shadow:
			0 1px 3px rgba(0, 0, 0, 0.45),
			0 8px 24px rgba(0, 0, 0, 0.3);
		margin-bottom: var(--space-6-5);
	}

	.hero p.tagline {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: var(--fw-regular);
		font-size: var(--fs-tagline);
		color: var(--color-text-on-dark);
		text-shadow:
			0 1px 3px rgba(0, 0, 0, 0.45),
			0 8px 24px rgba(0, 0, 0, 0.3);
		max-width: 480px;
		margin: 0 0 var(--space-8);
	}

	.hero-ctas {
		display: flex;
		align-items: center;
		gap: var(--space-6-5);
		flex-wrap: wrap;
	}

	.btn-primary {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-on-accent);
		background: var(--color-accent-solid);
		padding: var(--space-4) var(--space-7-5);
		border-radius: 999px;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
		display: inline-block;
	}

	.btn-primary:hover {
		background: var(--color-accent);
		transform: translateY(-1px);
	}

	.btn-secondary {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-accent-solid);
		background: var(--cream);
		border: var(--border-hairline) solid var(--color-accent-solid);
		padding: calc(var(--space-4) - var(--border-hairline)) calc(var(--space-7-5) - var(--border-hairline));
		border-radius: 999px;
		transition:
			background 0.15s ease,
			color 0.15s ease;
		display: inline-block;
	}

	.btn-secondary:hover {
		background: var(--color-accent-solid);
		color: var(--color-on-accent);
	}

	.contact-tertiary {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		font-weight: var(--fw-medium);
		color: var(--color-accent-on-dark);
		background: rgba(0, 0, 0, 0.55);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
		margin-top: var(--space-5);
	}

	.contact-tertiary :global(a) {
		color: var(--color-accent-on-dark);
		text-decoration: underline;
	}

	.contact-tertiary :global(a:hover) {
		color: var(--color-accent-on-dark-hover);
	}
</style>

<script>
	// Number assembled from non-contiguous parts and inserted into the DOM
	// only after page load — never sitting as plain text/href in the page
	// source — so scraping bots reading raw HTML don't pick it up, while a
	// human visitor sees and can tap it normally.
	const el = document.getElementById('hero-tertiary');
	if (el) {
		const parts = ['0494', '746', '502'];
		const number = parts.join('');
		const display = parts.join(' ');
		const message =
			"Hi Ben, I found your site and I'm thinking about counselling. Would love to have a chat when you're free.";
		el.innerHTML = `Or <a href="sms:${number}?body=${encodeURIComponent(message)}" data-goatcounter-click="hero-text">text</a> or <a href="tel:${number}" data-goatcounter-click="hero-call">call</a>: ${display}`;
	}
</script>
