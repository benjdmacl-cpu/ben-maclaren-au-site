---
// Deliberately not using JournalPost.astro here — that layout assumes a
// single continuous read, and this page's shape is different: bio prose,
// accreditation/training lists, and a headshot. Built directly on the base
// Layout instead.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
// Same portrait used on the homepage (Meet.astro) — reused rather than a
// separate about-page photo.
import portrait from '../assets/portrait/ben-maclaren.jpg';

// Registration confirmed — "ACA-registered counsellor" is now accurate
// (previously this used softer "working toward Level 1" wording until
// registration came through). Membership number also changed to R84574.
---

<Layout
	title="About Ben Maclaren — Counsellor in Canberra, ACT"
	description="Ben Maclaren is a counsellor in Canberra, ACT working with men, neurodivergent people, and LGBTQ+ clients. Background in journalism and design. ACA-registered counsellor."
	noindex
>
	<article class="about-page">
		<div class="wrap">
			<a class="back-link" href="/">← Home</a>

			<div class="about-head">
				<span class="eyebrow">About</span>
				<h1>Me, Myself and Ben</h1>
			</div>

			<div class="about-body">
				<div class="about-intro">
					<div class="headshot">
						<Image src={portrait} alt="Ben Maclaren, counsellor in Canberra, ACT" width={320} height={400} />
					</div>

					<p>
						Before becoming a counsellor I spent years facilitating groups and teams. These days I
						find myself working with folks from all walks of life, including men, neurodiverse folk,
						and youth.
					</p>
				</div>

				<p>
					I'm based in Canberra and see clients both in person and online. My job is to support you
					in figuring out what is happening and find ways to change that help a good life.
				</p>

				<p>
					Outside one-on-one sessions, I facilitate a fortnightly men's peer-support walking group
					with The Man Walk Australia here in Canberra and run group sessions.
				</p>
			</div>

			<div class="about-section">
				<h2>What approaches do you use?</h2>
				<p>
					My approach centres you as the agent to your own life and myself as fellow traveller
					with expertise about the mind, body and spirit.
				</p>
				<p>
					My role is to be your non-judgemental supporter; to create an environment for safe
					exploration, growth, discovery and reflection; a sort of sandbox for life, preferably
					with less grit in the shirt.
				</p>
				<ul class="principles-list">
					<li>
						<strong>Neuroaffirming:</strong> Many people think and see the world differently from
						the stock standard norm. Sometimes we might see ourselves as a bit different or fringe;
						I work with you the way your brain works to build a life that works the way you do.
					</li>
				</ul>
			</div>

			<div class="accreditation">
				<h2>Accreditation</h2>
				<ul class="credential-list">
					<li class="credential-item">
						<p class="credential-title">ACA-registered counsellor (R84574)</p>
					</li>
					<li class="credential-item">
						<p class="credential-title">University of Canberra</p>
						<p class="credential-org">Masters of Counselling, Counselling</p>
						<p class="credential-date">Feb 2025 – Mar 2027</p>
					</li>
				</ul>
			</div>

			<div class="accreditation">
				<h2>Training</h2>
				<ul class="credential-list">
					<li class="credential-item">
						<p class="credential-title">Gestalt Play Therapy: Oaklander's Approach for all ages</p>
						<p class="credential-org">Sydney Centre for Creative Change</p>
						<p class="credential-date">Issued Sep 2026</p>
					</li>
					<li class="credential-item">
						<p class="credential-title">ACA 2026 Child &amp; Youth Symposium</p>
						<p class="credential-date">22 Oct 2026</p>
					</li>
				</ul>
			</div>
		</div>
	</article>
</Layout>

<style>
	.about-page {
		padding: var(--space-15) 0 var(--space-27-5);
	}

	.wrap {
		max-width: 720px;
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		display: inline-block;
		margin-bottom: var(--space-12);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.about-head {
		margin-bottom: var(--space-10);
	}

	.about-head .eyebrow {
		margin-bottom: var(--space-4-5);
		display: block;
	}

	.about-head h1 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
	}

	.about-body p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5-5);
	}

	.about-body p:last-child {
		margin-bottom: 0;
	}

	.about-intro {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--space-8);
		align-items: start;
		margin-bottom: var(--space-5-5);
	}

	.about-intro p {
		margin: 0;
	}

	.headshot {
		aspect-ratio: 4 / 5;
		max-width: 320px;
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	.headshot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.about-section {
		margin-top: var(--space-12);
		padding-top: var(--space-10);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.about-section h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-5-5);
	}

	.about-section p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5-5);
	}

	.about-section p:last-child {
		margin-bottom: 0;
	}

	.principles-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.principles-list li {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
	}

	.principles-list strong {
		color: var(--color-text-primary);
		font-weight: var(--fw-medium);
	}

	.accreditation {
		margin-top: var(--space-12);
		padding-top: var(--space-10);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.accreditation h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-8);
	}

	.credential-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.credential-title {
		font-size: var(--fs-prose-body);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		margin: 0;
	}

	.credential-org {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: var(--space-1) 0 0;
	}

	.credential-date {
		font-family: var(--font-mono);
		font-size: var(--fs-eyebrow);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
	}

	@media (max-width: 480px) {
		.about-intro {
			grid-template-columns: 1fr;
		}

		.headshot {
			max-width: 240px;
			margin: 0 0 var(--space-5);
		}
	}
</style>
