---
// Deliberately not using JournalPost.astro here — that layout assumes a
// single continuous read, and this page's shape is different: bio prose,
// an accreditation list, and three photos placed through the page rather
// than clustered at the top. Built directly on the base Layout instead.
import Layout from '../layouts/Layout.astro';

// Photo placeholders — no source files exist yet. Once real photos are
// dropped into src/assets/about/, replace each .photo-slot below with:
//   import { Image } from 'astro:assets';
//   import headshot from '../assets/about/headshot.jpg';
//   <Image src={headshot} alt="..." width={...} height={...} class="..." />
// Sharp (via Astro's <Image>) handles resize/webp conversion automatically
// — source files don't need pre-optimizing first.

// ACA wording below is deliberate: use "ACA member, working toward Level 1
// registration" rather than "ACA-registered counsellor" until registration
// is actually confirmed. Re-check and update once Level 1 comes through —
// this note is in the frontmatter (not an HTML comment in the template)
// specifically so the avoided phrase doesn't end up sitting in the page's
// rendered source as comment text.
---

<Layout
	title="About Ben Maclaren — Counsellor in Canberra, ACT"
	description="Ben Maclaren is a counsellor in Canberra, ACT working with men, neurodivergent people, and LGBTQ+ clients. Background in journalism and design. ACA member."
	noindex
>
	<article class="about-page">
		<div class="wrap">
			<a class="back-link" href="/">← Home</a>

			<div class="about-head">
				<span class="eyebrow">About</span>
				<h1>About Ben</h1>
			</div>

			<div class="about-body">
				<div class="photo-slot photo-slot--headshot" role="img" aria-label="Ben Maclaren, counsellor in Canberra, ACT">
					<p class="photo-slot-label">
						Headshot placeholder<br />
						<span>Alt text: "Ben Maclaren, counsellor in Canberra, ACT"</span>
					</p>
				</div>

				<p>
					Before becoming a counsellor I spent years facilitating groups and teams. These days I
					find myself working with folks from all walks of life, including men, neurodiverse folk,
					and youth.
				</p>

				<p>It's the work of figuring out how to live a good life.</p>

				<div
					class="photo-slot photo-slot--wide photo-slot--environment"
					role="img"
					aria-label="Ben Maclaren in his counselling room in Canberra"
				>
					<p class="photo-slot-label">
						Environment shot placeholder<br />
						<span>Alt text: "Ben Maclaren in his counselling room in Canberra"</span>
					</p>
				</div>

				<p>
					I work often with neurodivergent people too, of all ages. Autism, ADHD, sensory
					differences, and the anxiety that tends to ride along with them.
				</p>

				<p>
					My approach is neuro-affirming: you don't need fixing, just someone who supports you in how
					your mind actually works and is here to help.
				</p>

				<div
					class="photo-slot photo-slot--wide photo-slot--facilitation"
					role="img"
					aria-label="Ben Maclaren facilitating a Man Walk group session in Canberra"
				>
					<p class="photo-slot-label">
						Facilitation shot placeholder<br />
						<span>Alt text: "Ben Maclaren facilitating a Man Walk group session in Canberra"</span>
					</p>
				</div>

				<p>
					Outside one-on-one sessions, I facilitate a fortnightly men's peer-support walking group
					with The Man Walk Australia here in Canberra.
				</p>

				<p>
					I'm based in Canberra and see clients both in person and online. I keep things simple: no
					jargon, no performance, just space to work things out.
				</p>
			</div>

			<div class="accreditation">
				<h2>Accreditation &amp; training</h2>
				<dl class="accreditation-list">
					<div class="accreditation-item">
						<dt>Australian Counselling Association (ACA)</dt>
						<dd>
							ACA member, working toward Level 1 registration (S84574). Placement complete; final
							grading and transcript pending.
						</dd>
					</div>
					<div class="accreditation-item">
						<dt>Training</dt>
						<dd>Gestalt Play Therapy.</dd>
					</div>
					<div class="accreditation-item">
						<dt>Facilitation</dt>
						<dd>
							Man-bassador, The Man Walk Australia (since May 2026); prior Facilitator / Career
							Counsellor &amp; Coach, Case Study Club (2022–2025).
						</dd>
					</div>
				</dl>
			</div>
		</div>
	</article>
</Layout>

<style>
	.about-page {
		padding: var(--space-15) 0 var(--space-27-5);
	}

	.wrap {
		max-width: 720px;
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		display: inline-block;
		margin-bottom: var(--space-12);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.about-head {
		margin-bottom: var(--space-10);
	}

	.about-head .eyebrow {
		margin-bottom: var(--space-4-5);
		display: block;
	}

	.about-head h1 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
	}

	.about-body p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5-5);
	}

	.about-body p:last-child {
		margin-bottom: 0;
	}

	.photo-slot {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		background: var(--color-bg-card);
		border: var(--border-hairline) dashed var(--color-border);
		border-radius: var(--radius-card);
		margin: 0 0 var(--space-8);
	}

	.photo-slot--headshot {
		aspect-ratio: 4 / 5;
		max-width: 320px;
	}

	.photo-slot--wide {
		aspect-ratio: 16 / 9;
	}

	.photo-slot-label {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		margin: 0;
		padding: var(--space-6);
	}

	.photo-slot-label span {
		font-size: var(--fs-micro);
	}

	.accreditation {
		margin-top: var(--space-12);
		padding-top: var(--space-10);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.accreditation h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-8);
	}

	.accreditation-list {
		margin: 0;
	}

	.accreditation-item {
		padding: var(--space-4) 0;
		border-bottom: var(--border-hairline) solid var(--color-border);
	}

	.accreditation-item:first-child {
		padding-top: 0;
	}

	.accreditation-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.accreditation-item dt {
		font-family: var(--font-mono);
		font-size: var(--fs-eyebrow);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: var(--space-2);
	}

	.accreditation-item dd {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media (max-width: 480px) {
		.photo-slot--headshot {
			max-width: 100%;
		}
	}
</style>
