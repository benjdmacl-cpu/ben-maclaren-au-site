---
// Deliberately not using JournalPost.astro here — that layout assumes a
// single continuous read, and this page's shape is different: bio prose,
// accreditation/training lists, and a headshot. Built directly on the base
// Layout instead.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
// Two dedicated About-page photos (not the homepage portrait). Neither is a
// tight close-up crop, so each headshot container's object-position is
// tuned individually to keep him in frame rather than centred.
import forestPhoto from '../assets/about/headshot-forest.jpg';
import fishingPhoto from '../assets/about/headshot.jpg';

// Registration confirmed — "ACA-registered counsellor" is now accurate
// (previously this used softer "working toward Level 1" wording until
// registration came through). Membership number also changed to R84574.
---

<Layout
	title="About Ben Maclaren — Counsellor in Canberra, ACT"
	description="Ben Maclaren is an ACA-registered counsellor in Canberra, ACT, working with men, neurodivergent people, and LGBTQ+ clients. Background in journalism and design."
>
	<article class="about-page">
		<div class="wrap">
			<a class="back-link" href="/">← Home</a>

			<div class="about-head">
				<span class="eyebrow">About</span>
				<h1>Me, Myself and Ben</h1>
			</div>

			<div class="about-body">
				<div class="about-intro">
					<div class="headshot headshot--forest">
						<Image src={forestPhoto} alt="Ben Maclaren, counsellor in Canberra, ACT" width={520} height={650} />
					</div>

					<div class="about-intro-text">
						<p>
							Before being a counsellor, I was a small boy diagnosed with Asperger's in 2001 who
							hated being told what he could do.
						</p>

						<p>
							Shift forward to my 20s, I struggled to get into university; learning was especially
							hard when I refused to ask for help.
						</p>

						<p>
							I also got my try at relationships, and learned how hard it was to communicate well,
							to competently know what I was feeling, what my own needs were, how to set
							boundaries, and how to support others.
						</p>
					</div>
				</div>

				<div class="about-intro about-intro--reverse">
					<div class="about-intro-text">
						<p>
							These days I find myself working with folks from all walks of life, including
							<strong>men, neurodiverse folk, and youth</strong>.
						</p>

						<p>
							I'm based in <strong>Canberra</strong> and see clients both
							<strong>in person and online</strong>. My job is to support you in figuring out what is
							happening and find ways that help you live a good life.
						</p>

						<p>If this sounds like a good fit, <a href="/#contact">get in touch</a>.</p>
					</div>

					<div class="headshot headshot--fishing">
						<Image src={fishingPhoto} alt="Ben Maclaren fly fishing by a lake" width={520} height={650} />
					</div>
				</div>

			<div class="about-section">
				<h2>What approaches do you use?</h2>
				<p>
					My approach centres you as the agent to your own life and myself as fellow traveller
					with expertise about the mind, body, and spirit.
				</p>
				<p>
					My role is to be your non-judgemental supporter; to create an environment for safe
					exploration, growth, discovery, and reflection; a sort of sandbox for life, preferably
					with less grit in the shirt.
				</p>
				<ul class="principles-list">
					<li>
						<strong>Neuroaffirming:</strong> Many people think and see the world differently from
						the stock standard norm. Sometimes we might see ourselves as a bit different or fringe;
						I work with you the way your brain works to build a life that works the way you do.
					</li>
				</ul>
			</div>

			<div class="accreditation">
				<h2>Accreditation</h2>
				<ul class="credential-list">
					<li class="credential-item">
						<p class="credential-title">ACA-registered counsellor (R84574)</p>
					</li>
					<li class="credential-item">
						<p class="credential-title">University of Canberra</p>
						<p class="credential-org">Masters of Counselling, Counselling</p>
						<p class="credential-date">Feb 2025 – Mar 2027</p>
					</li>
				</ul>
			</div>

			<div class="accreditation">
				<h2>Training</h2>
				<ul class="credential-list">
					<li class="credential-item">
						<p class="credential-title">Gestalt Play Therapy: Oaklander's Approach for all ages</p>
						<p class="credential-org">Sydney Centre for Creative Change</p>
						<p class="credential-date">Issued Sep 2026</p>
					</li>
					<li class="credential-item">
						<p class="credential-title">ACA 2026 Child &amp; Youth Symposium</p>
						<p class="credential-date">22 Oct 2026</p>
					</li>
				</ul>
			</div>
		</div>
	</article>
</Layout>

<style>
	.about-page {
		padding: var(--space-15) 0 var(--space-27-5);
	}

	.wrap {
		max-width: 720px;
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		display: inline-block;
		margin-bottom: var(--space-12);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.about-head {
		margin-bottom: var(--space-10);
	}

	.about-head .eyebrow {
		margin-bottom: var(--space-4-5);
		display: block;
	}

	.about-head h1 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
	}

	.about-body p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5-5);
	}

	.about-body p:last-child {
		margin-bottom: 0;
	}

	.about-intro {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: var(--space-8);
		align-items: center;
		margin-bottom: var(--space-12);
	}

	.about-intro--reverse {
		grid-template-columns: 1fr 340px;
	}

	.about-intro-text p {
		margin: 0 0 var(--space-5-5);
	}

	.about-intro-text p:last-child {
		margin-bottom: 0;
	}

	.about-intro-text a {
		color: var(--color-text-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.about-intro-text a:hover {
		color: var(--color-accent);
	}

	.headshot {
		aspect-ratio: 4 / 5;
		max-width: 520px;
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	.headshot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 50%;
		display: block;
	}

	/* Forest photo (landscape source, face just right of centre) and fishing
	   photo (candid, body weighted toward the bottom) each need their own
	   crop focus rather than the shared default above. */
	.headshot--forest :global(img) {
		object-position: 55% 50%;
	}

	.headshot--fishing :global(img) {
		object-position: 50% 70%;
	}

	.about-section {
		margin-top: var(--space-12);
		padding-top: var(--space-10);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.about-section h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-5-5);
	}

	.about-section p {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-5-5);
	}

	.about-section p:last-child {
		margin-bottom: 0;
	}

	.principles-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.principles-list li {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
	}

	.principles-list strong {
		color: var(--color-text-primary);
		font-weight: var(--fw-medium);
	}

	.accreditation {
		margin-top: var(--space-12);
		padding-top: var(--space-10);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.accreditation h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-8);
	}

	.credential-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.credential-title {
		font-size: var(--fs-prose-body);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		margin: 0;
	}

	.credential-org {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: var(--space-1) 0 0;
	}

	.credential-date {
		font-family: var(--font-mono);
		font-size: var(--fs-eyebrow);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
	}

	@media (max-width: 480px) {
		.about-intro {
			grid-template-columns: 1fr;
		}

		.headshot {
			max-width: 240px;
			margin: 0 0 var(--space-5);
		}
	}
</style>
