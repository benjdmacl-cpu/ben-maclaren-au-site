---
import Layout from '../layouts/Layout.astro';
import PlaceholderSection from '../components/PlaceholderSection.astro';
---

<Layout
	title="Sex and Relationships — Ben Maclaren"
	description="Ben Maclaren's approach to working with clients on sex and relationships."
>
	<article class="sex-relationships-page">
		<div class="wrap">
			<a class="back-link" href="/">← Home</a>
			<span class="eyebrow">Relationships</span>
			<h1>All about sex and relationships</h1>
		</div>
	</article>
	<PlaceholderSection
		title="Lorem ipsum dolor sit amet"
		body="Consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
		background="page"
	/>
</Layout>

<style>
	.sex-relationships-page {
		padding: var(--space-20) 0 0;
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		margin-bottom: var(--space-8);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.eyebrow {
		margin-bottom: var(--space-4);
		display: block;
	}

	h1 {
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		font-weight: var(--fw-medium);
		max-width: 640px;
	}
</style>
