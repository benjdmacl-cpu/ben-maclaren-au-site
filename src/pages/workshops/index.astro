---
import Layout from '../../layouts/Layout.astro';
import { WORKSHOPS } from '../../lib/workshops-data';
---

<Layout
	title="Workshops — Ben Maclaren"
	description="Workshops run by Ben Maclaren, a counsellor in Canberra, ACT."
>
	<article class="workshops-page">
		<div class="wrap">
			<a class="back-link" href="/">← Home</a>
			<span class="eyebrow">Workshops</span>
			<h1>Creating healthier communities and institutions</h1>

			{
				WORKSHOPS.map((workshop) => (
					<div class="workshops-row">
						<a class="workshops-row-media" href={`/workshops/${workshop.slug}`} aria-hidden="true" tabindex="-1">
							<span class="workshops-row-media-label">Image placeholder</span>
						</a>
						<div class="workshops-row-content">
							<a class="workshops-row-title" href={`/workshops/${workshop.slug}`}>
								{workshop.title}
							</a>
							<p class="workshops-row-audience">{workshop.audience.join(' · ')}</p>
							<p class="workshops-row-intro">{workshop.intro}</p>
						</div>
					</div>
				))
			}
		</div>
	</article>
</Layout>

<style>
	.workshops-page {
		padding: var(--space-20) 0 var(--space-27-5);
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		margin-bottom: var(--space-8);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.eyebrow {
		margin-bottom: var(--space-4);
		display: block;
	}

	h1 {
		font-size: var(--fs-hero);
		line-height: var(--lh-hero);
		font-weight: var(--fw-medium);
		max-width: 760px;
		margin-bottom: var(--space-15);
		padding-bottom: var(--space-13);
		border-bottom: var(--border-hairline) solid var(--color-border);
	}

	.workshops-row {
		display: flex;
		align-items: center;
		gap: var(--space-10);
		max-width: 960px;
		padding: var(--space-13) 0;
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.workshops-row:first-of-type {
		border-top: none;
		padding-top: 0;
	}

	.workshops-row:last-of-type {
		padding-bottom: 0;
	}

	.workshops-row-media {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 280px;
		aspect-ratio: 4 / 3;
		text-align: center;
		background: var(--color-bg-card);
		border: var(--border-hairline) dashed var(--color-border);
		border-radius: var(--radius-card);
	}

	.workshops-row-media-label {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		padding: var(--space-4);
	}

	.workshops-row-content {
		flex: 1 1 auto;
		min-width: 0;
	}

	.workshops-row-title {
		display: block;
		font-family: var(--font-display);
		font-size: var(--fs-display);
		line-height: var(--lh-article-title);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.workshops-row-title:hover {
		color: var(--color-accent);
	}

	.workshops-row-audience {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-wide-label);
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: var(--space-2) 0 var(--space-3);
	}

	.workshops-row-intro {
		font-size: var(--fs-prose-body);
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media (max-width: 720px) {
		.workshops-row {
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-5);
		}

		.workshops-row-media {
			width: 100%;
		}
	}
</style>
