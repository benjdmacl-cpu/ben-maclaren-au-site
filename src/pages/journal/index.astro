---
import { getCollection } from 'astro:content';
import FeaturedCard from '../../components/FeaturedCard.astro';
import JournalCard from '../../components/JournalCard.astro';
import JournalFilterBar from '../../components/JournalFilterBar.astro';
import ResourceIcon from '../../components/ResourceIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { CATEGORY_ORDER } from '../../lib/journal-labels';

const allPosts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Three pools, not a recency-tiered pipeline. Precedence: featured wins over
// guide if a post is somehow both (mirrors the old local-overrides-guide
// rule from before this restructure) — it renders once, pinned at top, and
// is excluded from both the guide grid and the flat grid below.
const featured = allPosts.find((post) => post.data.featured);
const guides = allPosts.filter((post) => post.data.tags.includes('guide') && post.id !== featured?.id);
const flatPosts = allPosts.filter(
	(post) => post.id !== featured?.id && !post.data.tags.includes('guide'),
);

// Filter bar options — only categories/tags actually present in the flat
// grid (featured and guides aren't part of the filtered set, so their
// categories/tags don't need a filter button).
const categoriesInUse = CATEGORY_ORDER.filter((category) =>
	flatPosts.some((post) => post.data.category === category),
);
const tagsInUse = [...new Set(flatPosts.flatMap((post) => post.data.tags))];
---

<Layout
	title="Field Journal — Ben Maclaren"
	description="Common questions from clients, worked through in plain terms. Field notes on counselling from Ben Maclaren, counsellor in Canberra, ACT."
	noindex
>
	<div class="wip-banner">
		<p>This page is a work in progress and not currently in use.</p>
	</div>

	<div class="wrap top-nav">
		<a class="back-link" href="/">← Home</a>
	</div>

	<section class="masthead">
		<svg class="masthead-motif" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<circle cx="100" cy="100" r="6" fill="none" stroke-width="1.4"></circle>
			<circle cx="100" cy="100" r="20" fill="none" stroke-width="1.4"></circle>
			<circle cx="100" cy="100" r="38" fill="none" stroke-width="1.2" opacity="0.75"></circle>
			<circle cx="100" cy="100" r="60" fill="none" stroke-width="1" opacity="0.5"></circle>
			<circle cx="100" cy="100" r="86" fill="none" stroke-width="0.8" opacity="0.3"></circle>
		</svg>
		<div class="wrap">
			<span class="eyebrow">Notes on the work</span>
			<h1>Field Journal</h1>
			<p class="subtitle">Common questions from clients, worked through in plain terms.</p>
		</div>
	</section>

	{
		allPosts.length === 0 ? (
			<section class="journal-empty">
				<div class="wrap">
					<p class="empty">No articles published yet — check back soon.</p>
				</div>
			</section>
		) : (
			<section class="library">
				<div class="wrap">
					{featured && (
						<FeaturedCard
							href={`/journal/${featured.id}/`}
							title={featured.data.title}
							excerpt={featured.data.description}
							date={featured.data.date}
							category={featured.data.category}
						/>
					)}

					{flatPosts.length > 0 && (
						<>
							<JournalFilterBar categories={categoriesInUse} tags={tagsInUse} />
							<div class="journal-grid">
								{flatPosts.map((post) => (
									<JournalCard
										href={`/journal/${post.id}/`}
										title={post.data.title}
										excerpt={post.data.description}
										date={post.data.date}
										category={post.data.category}
										tags={post.data.tags}
									/>
								))}
							</div>
						</>
					)}
				</div>
			</section>
		)
	}

	{
		guides.length > 0 && (
			<section class="guides">
				<div class="wrap">
					<div class="guides-header">
						<h2>Guides</h2>
						<p class="guides-note">Practical walk-throughs for navigating the system</p>
					</div>
					<div class="guides-grid">
						{guides.map((guide) => (
							<a class="guide-tile" href={`/journal/${guide.id}/`}>
								<div class="guide-tile-top">
									<ResourceIcon icon={guide.data.icon ?? 'file-text'} size={20} />
									<span class="guide-tag">Guide</span>
								</div>
								<h3 class="guide-title">{guide.data.title}</h3>
								<p class="guide-desc">{guide.data.description}</p>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>

<style>
	.wip-banner {
		background: var(--color-accent-solid);
		padding: var(--space-2) var(--space-4);
		text-align: center;
	}

	.wip-banner p {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		color: var(--color-on-accent);
	}

	.top-nav {
		padding-top: var(--space-10);
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-label);
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-text-secondary);
		display: inline-block;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	/* ---------- Masthead ---------- */
	.masthead {
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: var(--space-12) 0 var(--space-14);
		border-bottom: var(--border-strong) solid var(--color-border-strong);
	}

	.masthead-motif {
		position: absolute;
		top: -30px;
		right: -30px;
		width: 220px;
		height: 220px;
		opacity: 0.18;
		z-index: 0;
		color: var(--terracotta);
		pointer-events: none;
	}

	.masthead-motif circle {
		stroke: currentColor;
	}

	.masthead .wrap {
		position: relative;
		z-index: 1;
	}

	.masthead .eyebrow {
		font-size: var(--fs-caption);
		letter-spacing: var(--ls-wide-label);
		margin-bottom: var(--space-3-5);
		display: block;
	}

	.masthead h1 {
		font-size: var(--fs-display);
		font-weight: var(--fw-medium);
		margin-bottom: var(--space-3);
	}

	.subtitle {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: var(--fw-regular);
		font-size: var(--fs-h3);
		color: var(--color-text-secondary);
		max-width: 480px;
		margin: 0 auto;
	}

	/* ---------- Library: featured + flat grid ---------- */
	.library {
		padding: var(--space-14) 0;
	}

	.journal-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-6);
	}

	/* ---------- Guides ---------- */
	.guides {
		padding: var(--space-14) 0 var(--space-20);
		border-top: var(--border-hairline) solid var(--color-border);
	}

	.guides-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		margin-bottom: var(--space-8);
	}

	.guides-header h2 {
		font-size: var(--fs-tagline);
		font-weight: var(--fw-medium);
	}

	.guides-note {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		margin: 0;
	}

	.guides-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-6);
	}

	.guide-tile {
		display: block;
		background: var(--color-bg-card);
		border-radius: var(--radius-card);
		padding: var(--space-6);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.guide-tile:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(56, 44, 36, 0.1);
	}

	.guide-tile-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-4);
	}

	.guide-tag {
		font-family: var(--font-mono);
		font-size: var(--fs-micro);
		letter-spacing: var(--ls-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.guide-title {
		font-size: var(--fs-sidebar-headline);
		font-weight: var(--fw-medium);
		color: var(--color-text-primary);
		margin: 0 0 var(--space-2);
		transition: color 0.15s ease;
	}

	.guide-tile:hover .guide-title {
		color: var(--color-accent);
	}

	.guide-desc {
		font-size: var(--fs-caption);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* ---------- Empty state ---------- */
	.journal-empty {
		padding: var(--space-15) 0 var(--space-30);
	}

	.empty {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--fs-prose-quote);
		color: var(--color-text-secondary);
	}

	@media (max-width: 820px) {
		.journal-grid {
			grid-template-columns: 1fr;
		}

		.guides-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
